root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.ps1]
# Sin BOM: con BOM falla "irm ... | iex". El codigo va en ASCII; las tildes, solo en comentarios.
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
